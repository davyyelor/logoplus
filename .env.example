# ==========================================================================
# LogoPlus — environment variables template.
#
# Copy this file to `.env` (git-ignored) and fill in real values LOCALLY.
# NEVER commit real credentials. `.env`, `.env.local` and `.env.prod` are
# git-ignored on purpose.
#
# These are read from the OS environment by Spring Boot. On PowerShell you can
# export them with:  $env:SUPABASE_DB_PASSWORD = "..."   (see README section 4).
# ==========================================================================

# --- Database: Supabase PostgreSQL (primary) ------------------------------
# JDBC URL of your Supabase project database. Keep sslmode=require and point
# currentSchema at the app schema.
SUPABASE_DB_URL=jdbc:postgresql://db.zxxrjvceoobnclgdckwh.supabase.co:5432/postgres?sslmode=require&currentSchema=app
SUPABASE_DB_USERNAME=postgres
# Your Supabase database password. Placeholder only — set the real value in .env.
SUPABASE_DB_PASSWORD=Erdavy.20!!

# --- Database fallback behaviour ------------------------------------------
# true  -> fall back to H2 in-memory when Supabase is missing/unreachable (dev).
# false -> fail fast if Supabase is configured but cannot be reached (prod).
APP_DB_FALLBACK_TO_H2=true

# Seed demo data (users, patients, templates). Keep false against a real DB.
APP_SEED_DEMO_DATA=false

# --- Security -------------------------------------------------------------
# JWT signing secret (>= 32 bytes). Override in every shared/prod environment.
APP_SECURITY_JWT_SECRET=change-me-please-32bytes-min-secret!!

# --- Optional V2 integrations (safe defaults keep them disabled) ----------
STRIPE_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=0
CALENDAR_PROVIDER=disabled
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
SIGNATURE_PROVIDER=internal-basic
